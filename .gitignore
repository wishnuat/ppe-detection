venv/
.venv/
__pycache__/
*.pyc
.env
frame.jpg

# Model artifacts (jangan commit — download via script)
# Pola tanpa slash berlaku di semua level, jadi yolov8n.pt di root ikut terjaring.
*.pt
*.onnx
*.tflite

# KECUALI weights hasil training final. Sengaja di-commit meski aturan di atas
# melarang .pt, karena tanpa ini `git clone` menghasilkan models/ kosong dan
# demo tidak bisa dijalankan sebelum training berjam-jam — Roboflow tidak
# menyediakan download .pt untuk model yang dilatih di platform mereka.
# Ukurannya 6,2 MB: jauh di bawah limit 100 MB GitHub, tidak butuh Git LFS.
# Ini juga syarat deploy ke HuggingFace Spaces / Railway yang tanpa volume mount.
!models/best.pt

# OpenVINO IR hasil scripts/export_openvino.py (best.bin bisa belasan MB)
models/*_openvino_model/

# Roboflow downloaded dataset artifacts
datasets/
ppes-*/
*.zip

# Profil setting UI — isinya preferensi lokal per instalasi, bukan kode
config/ui_profiles.json

# Runtime output
outputs/
runs/
logs/
*.mp4
*.avi

# IDE
.idea/
.vscode/
