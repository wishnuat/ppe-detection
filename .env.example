# Roboflow API key (untuk download model .pt)
ROBOFLOW_API_KEY=your_api_key_here

# Roboflow project info (default sudah sesuai model existing)
ROBOFLOW_WORKSPACE=wishnus-workspace
ROBOFLOW_PROJECT=ppe-detection-hyeuz-6cijw
ROBOFLOW_VERSION=2

# Model file path (auto-diisi setelah download)
MODEL_PATH=models/best.pt

# Inference config
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Backend inference: torch | openvino | openvino-int8 | roboflow
# Dipakai FastAPI & default CLI/Streamlit. `torch` = models/best.pt.
INFERENCE_BACKEND=torch

# Khusus backend OpenVINO
OPENVINO_DEVICE=CPU
# Override lokasi folder IR kalau tidak memakai default models/best*_openvino_model
# OPENVINO_MODEL_DIR=models/best_openvino_model

# API endpoint FastAPI.
# JANGAN pakai nama `API_URL` — SDK roboflow membaca env var itu sebagai
# base URL-nya sendiri dan akan gagal connect.
PPE_API_URL=http://localhost:8000

# ============================================================ FATIGUE & ABSENSI

# Backend face recognition untuk absensi: sface | insightface
# sface (default) jalan di atas opencv-python yang sudah ada, tanpa dependency
# tambahan. insightface lebih akurat pada pose miring tapi butuh
# `pip install insightface onnxruntime` dan unduhan ~330 MB.
#
# PENTING: embedding dari dua backend TIDAK sebanding. Kalau backend diganti,
# semua karyawan harus didaftarkan ulang.
EMBEDDER_BACKEND=sface

# Backend CNN fatigue: torch | openvino | openvino-int8
# Jalankan `python scripts/export_fatigue.py` dulu sebelum memakai openvino.
FATIGUE_BACKEND=torch

# Checkpoint classifier fatigue (hasil scripts/train_fatigue.py)
FATIGUE_MODEL_PATH=models/fatigue/fatigue_cls.pt

# Lokasi bobot pihak ketiga (YuNet, SFace, MediaPipe FaceLandmarker).
# Diunduh otomatis saat pertama dipakai; arahkan ke volume bersama di Docker
# supaya tidak diunduh ulang tiap container dibuat.
FATIGUE_ASSET_DIR=models/fatigue

# Database absensi (SQLite, satu file)
ATTENDANCE_DB=data/attendance.db

# Nama kamera yang ikut tercatat di setiap baris log absensi
CAMERA_NAME=kamera-1

# Matikan komponen kalau tidak dipakai — masing-masing menghemat memori & waktu
# muat. 0 = mati.
FATIGUE_ATTENDANCE=1

# Simpan riwayat fatigue (PERCLOS, microsleep, level) ke SQLite supaya bisa
# di-export jadi laporan. Tanpa ini, semuanya hilang saat aplikasi ditutup dan
# scripts/export_report.py tidak punya apa pun untuk dilaporkan.
FATIGUE_RECORDING=1

# CNN penampakan wajah. MATI secara default: pada wajah kamera nyata ia terukur
# tidak andal (rata-rata p(lelah) 0,57 pada foto pekerja lapangan; 59% orang
# biasa ditandai lelah). Sinyal perilaku tidak punya masalah ini.
# Nyalakan (=1) setelah model dilatih ulang dengan frame dari kamera Anda.
FATIGUE_CLASSIFIER=0

# Pasang endpoint /fatigue/* di FastAPI. Set 0 kalau mesin ini hanya untuk APD.
ENABLE_FATIGUE_API=1
